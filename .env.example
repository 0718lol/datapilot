# ===== DataPilot 环境变量 =====
# 复制为 .env 后按需修改；docker compose 会自动读取

# 模型提供方: mock(无需API key，开箱演示) | openai(任何OpenAI兼容接口)
MODEL_PROVIDER=mock

# OpenAI 兼容接口配置（私有化时指向 vLLM/Ollama，如 http://localhost:9997/v1）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxx
MODEL_NAME=gpt-4o-mini

# 初始管理员账号（首次启动自动创建，请尽快修改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT 密钥（生产环境务必更换）
JWT_SECRET=please-change-this-secret

# 数据库（本地开发默认 SQLite，docker compose 内自动改为 PostgreSQL）
# DATABASE_URL=postgresql+psycopg2://datapilot:datapilot@localhost:5432/datapilot
